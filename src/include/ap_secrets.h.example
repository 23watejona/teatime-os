#ifndef AP_SECRETS_H
#define AP_SECRETS_H

/* Target AP credentials. Copy this file to ap_secrets.h and fill in real values,
   or leave ap_secrets.h absent and let the build generate it from the WIFI_SSID,
   WIFI_PASS and WIFI_BSSID environment variables. ap_secrets.h is gitignored and
   must never be committed. */

#define AP_SSID  "YourNetworkName"
#define AP_PASS  "YourPassphrase"

/* BSSID as six comma-separated byte literals. */
#define AP_BSSID_BYTES  0x00, 0x00, 0x00, 0x00, 0x00, 0x00

#endif
